# Copy this file to .env (local dev) and set the same vars on Vercel for production.
# !!! ALL THREE OF THESE MUST BE SET ON VERCEL OR AUTH WILL FAIL WITH 500 ERRORS !!!

# DATABASE_URL — Neon Postgres connection string (Prisma-optimized format).
# Get this from your Neon dashboard → "Connection string" → "Prisma" tab.
# The pooled connection (host contains "-pooler") is recommended for serverless
# (Vercel, AWS Lambda) — it reuses connections across function invocations.
#
# Format: postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DB?channel_binding=require&connect_timeout=15&sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require

# NEXTAUTH_SECRET — required to sign/verify JWT sessions.
# Without this, NextAuth throws "There is a problem with the server configuration"
# and /api/auth/session returns 500. Generate one locally with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# NEXTAUTH_URL — your app's base URL.
# Local dev:    http://localhost:3000
# Production:   https://your-project.vercel.app
# (If not set on Vercel, the app falls back to VERCEL_URL which Vercel auto-sets.)
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# After setting DATABASE_URL + NEXTAUTH_SECRET + NEXTAUTH_URL:
#   bun run db:push     # create all tables in Neon
#   bun run db:clear    # seed roles + platforms + categories + admin user
# ---------------------------------------------------------------------------

# Other optional v2 env vars:
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=
# MEILISEARCH_HOST=
# MEILISEARCH_KEY=
# RESEND_API_KEY=
# MAIL_FROM=
# VIRUSTOTAL_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENTRY_DSN=
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_SITE_NAME=Free Programs Pro Store
